# 星流 LiblibAI 开放平台密钥（只放服务端，勿提交真实值）
LIBLIB_ACCESS_KEY=your_access_key
LIBLIB_SECRET_KEY=your_secret_key
PORT=8787

# 扣子 / Coze 工作流（只放服务端，勿提交真实 PAT）
# 1) 在 https://www.coze.cn/open/oauth/pats 创建个人访问令牌，勾选工作流 run 权限
# 2) 工作流必须先「发布」为 API；编排页 URL 里 workflow_id= 后面的数字即 ID
COZE_API_TOKEN=pat_your_personal_access_token
COZE_WORKFLOW_ID=your_workflow_id

# 可选：国内默认 api.coze.cn；国际版改成 https://api.coze.com
# COZE_API_BASE=https://api.coze.cn

# 可选：工作流在扣子应用内时填写 app_id（URL 中 project-ide 后的数字）
# COZE_APP_ID=

# 可选：含数据库/变量节点时需要关联智能体 bot_id（URL 中 bot 后的数字）
# COZE_BOT_ID=

# 开始节点输入参数名（在工作流开始节点里查看）
# COZE_TEXT_INPUT_KEY=input
# COZE_IMAGE_INPUT_KEY=image

# 若工作流必须带图，设为 true；页面会要求先上传主视觉
# COZE_REQUIRE_MAIN_VISUAL=false

# 工作流输出含图片时，是否写入海报背景图层
# COZE_APPLY_IMAGE_TO_BACKGROUND=true
